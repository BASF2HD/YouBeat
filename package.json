{
  "name": "albumforge-studio",
  "version": "1.0.0",
  "description": "AlbumForge Studio — batch album-video production for YouTube",
  "main": "dist/main/index.js",
  "author": "AlbumForge Studio",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build:renderer": "tsc -p tsconfig.renderer.json && vite build",
    "build:main": "tsc -p tsconfig.main.json && vite build --config vite.main.config.ts",
    "build": "npm run build:renderer && npm run build:main",
    "electron:dev": "electron .",
    "start": "node scripts/start.cjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "music-metadata": "^7.13.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  },
  "build": {
    "appId": "com.albumforge.studio",
    "productName": "AlbumForge Studio",
    "icon": "resources/albumforge-icon.png",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "beforePack": "./scripts/validate-package.cjs",
    "directories": {
      "output": "dist-package"
    },
    "files": [
      "dist/**/*",
      "resources/**/*",
      "index.html"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg*"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-win-${arch}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-Portable.${ext}"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.music"
    }
  }
}
