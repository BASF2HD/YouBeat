{
  "name": "youbeat",
  "version": "1.1.1",
  "description": "YouBeat — batch album-video production for YouTube",
  "main": "dist/main/index.js",
  "author": "YouBeat",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build:renderer": "tsc -p tsconfig.renderer.json && vite build",
    "build:main": "tsc -p tsconfig.main.json && vite build --config vite.main.config.ts",
    "build": "npm run build:renderer && npm run build:main",
    "electron:dev": "electron .",
    "start": "node scripts/start.cjs",
    "pack": "node scripts/prepare-ffmpeg.mjs && npm run build && electron-builder --dir --publish never",
    "dist": "node scripts/prepare-ffmpeg.mjs && npm run build && electron-builder --publish never",
    "dist:mac": "node scripts/prepare-ffmpeg.mjs && npm run build && electron-builder --mac --arm64 --publish never",
    "dist:mac:intel": "node scripts/prepare-ffmpeg.mjs && npm run build && electron-builder --mac --x64 --publish never",
    "dist:win": "node scripts/prepare-ffmpeg.mjs && npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "music-metadata": "^7.13.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  },
  "build": {
    "appId": "com.youbeat.app",
    "productName": "YouBeat",
    "icon": "resources/youbeat-icon.png",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "beforePack": "./scripts/validate-package.cjs",
    "directories": {
      "output": "dist-package"
    },
    "files": [
      "dist/**/*",
      "resources/**/*",
      "index.html",
      "!node_modules/**/*"
    ],
    "extraResources": [
      { "from": ".vendor/ffmpeg", "to": "ffmpeg" }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-win-${arch}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-Portable.${ext}"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.music",
      "identity": null,
      "minimumSystemVersion": "12.0"
    }
  }
}
